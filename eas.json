{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "development",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "ios": {},
      "android": {
        "gradleCommand": "./gradlew assembleRelease"
      }
    }
  },
  "submit": {
    "development": {},
    "preview": {},
    "production": {}
  }
}

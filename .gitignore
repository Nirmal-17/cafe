# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — never commit secrets
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# backend — the API is NOT kept inside this checkout, it runs from its own
# folder and is only referenced (see scripts/dev.js resolveBackendDir).
# Guard so a copied backend/ (with .env secrets + dev.db) can never be
# committed here by accident.
/backend/
backend/dist/
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/seed.js
backend/prisma/seed.js.map
backend/prisma/seed.d.ts
backend/prisma/seed.d.ts.map
backend/uploads/

# root-level Expo assets ARE tracked (src/ code references assets/images/*)

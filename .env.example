# Frontend (Expo) environment — copy to .env and adjust as needed.
# Backend server env lives in backend/.env (see backend/.env.example).

# Base URL of the CafeOS backend the app talks to.
# Optional — when unset the app resolves it automatically:
#   - Web:             same origin that serves the page
#   - Expo Go (phone): http://<dev-machine-LAN-IP>:3000 (auto-detected)
#   - Emulator/native: http://localhost:3000
# Explicit example for a custom server:
# EXPO_PUBLIC_API_URL=https://cafe.leadingedge.com.np

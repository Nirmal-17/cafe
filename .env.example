# Frontend (Expo) environment - copy to .env and adjust as needed.
# Backend server env lives in backend/.env (see backend/.env.example).

# Base URL of the CafeOS backend the app talks to.
# Optional - when unset the app defaults to https://cafeos.leadingedge.com.np
# (the login screen and Profile -> Configure Server URL can override it at runtime).
# Explicit override for a different/dev server:
# EXPO_PUBLIC_API_URL=http://localhost:3000
